# Deterministic installs (also mirrored in pnpm-workspace.yaml where applicable)
auto-install-peers=false
strict-peer-dependencies=false

# Reproducible CI/Docker installs
prefer-frozen-lockfile=true

# Native modules (better-sqlite3, esbuild) — align with pnpm-workspace.yaml onlyBuiltDependencies
enable-pre-post-scripts=true

# Network resilience (large monorepo / WSL2)
fetch-timeout=600000
fetch-retries=5
network-concurrency=8

# Keep store on Linux filesystem when developing in WSL2 (not under /mnt/c)
# Override locally if needed: pnpm config set store-dir ~/.local/share/pnpm/store
# store-dir=.pnpm-store

# Docker builds may set PNPM_CONFIG_DANGEROUSLY_ALLOW_ALL_BUILDS=true for native compile

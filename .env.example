# Root compose overrides (optional). Copy to .env in repo root for docker compose variable substitution.
# Service-specific secrets live in artifacts/api-server/.env and artifacts/pajoy/.env

POSTGRES_DB=pajoy
POSTGRES_USER=pajoy
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_PORT=5433
REDIS_PORT=6379
API_PORT=8080
FRONTEND_PORT=3000

# Empty = frontend nginx proxies /api to the api service (recommended for Docker)
VITE_API_URL=
